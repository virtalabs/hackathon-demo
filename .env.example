# Copy this file to .env before running any just targets.
#   cp .env.example .env

# ── Auth ────────────────────────────────────────────────────────────────────
# Static demo token shared between BlueFlow (API_TOKEN) and TapirXL
# (BLUEFLOW_TOKEN). Both services read this single value — do not split.
BLUEFLOW_API_TOKEN=demo-tapirxl-token-not-for-production
VIPER_API_KEY=demo-token-not-for-proudction-not-for-viper-main

# ── Image tags ───────────────────────────────────────────────────────────────
# Pin exact demo-<semver> tags. Never use `latest`.
BLUEFLOW_TAG=demo-0.3.5-rc5
TAPIRXL_TAG=demo-0.3.3
VIPER_TAG=demo-0.1.0
# Viper is built from source — no tag needed here until we publish a new image.

# ── Viper env vars -----──────────────────────────────────────────────────────
HELM_URL=https://helm-api.com/api/helm-get-sbom
HELM_TOKEN=
ANTHROPIC_API_KEY=
